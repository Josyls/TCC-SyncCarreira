# Raiz do monorepo. As subpastas Source/synccarreira-api e
# Source/synccarreira-frontend já têm seus próprios .gitignore (não editados
# aqui) — isto cobre o que sobra na raiz.

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.iml

# Build artifacts que podem aparecer fora das subpastas conhecidas
node_modules/
dist/
build/
.gradle/

# Metadado local do Vercel CLI (criado ao rodar `vercel deploy`; não deve
# ser versionado, e o .gitignore do próprio synccarreira-frontend não pode
# ser tocado — regra de ouro do legado)
.vercel/

# Screenshots/artefatos de verificação gerados durante o desenvolvimento
# (checkpoints locais, não fazem parte do produto)
*.png
*.jpg
*.jpeg

# Segredos que nunca devem ser versionados
.env
.env.local
*.pem
*.key
